<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_view_list_supplier_management" model="ir.ui.view">
        <field name="name">res.partner.list.supplier.management</field>
        <field name="model">res.partner</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Proveedores">
                <field name="complete_name" string="Nombre"/>
                <field name="vat" string="CUIT"/>
                <field name="company_ids" widget="many2many_tags" optional="show"/>
                <field name="city" optional="show"/>
                <field name="state_id" string="Provincia" optional="show"/>
                <field name="phone" optional="show"/>
                <field name="email" optional="show"/>
            </list>
        </field>
    </record>

    <record id="res_partner_view_search_supplier_management" model="ir.ui.view">
        <field name="name">res.partner.search.supplier.management</field>
        <field name="model">res.partner</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="company_ids" string="Empresas en las que participa"/>
                <field name="city" string="Ciudad"/>
                <field name="state_id" string="Provincia"/>
            </field>
            <filter name="filter_vat_set" position="before">
                <filter name="suppliers" string="Proveedores" domain="[('supplier_rank', '>', 0)]"/>
                <separator/>
                <filter name="has_payable_debt" string="Con deuda" domain="[('has_payable_debt', '=', True)]"/>
                <filter name="has_overdue_payable" string="Con vencidos" domain="[('has_overdue_payable', '=', True)]"/>
                <separator/>
            </filter>
            <filter name="salesperson" position="after">
                <filter name="group_statement_company" string="Empresas en las que participa"
                        context="{'group_by': 'company_ids'}"/>
                <filter name="group_city" string="Ciudad" context="{'group_by': 'city'}"/>
                <filter name="group_state" string="Provincia" context="{'group_by': 'state_id'}"/>
            </filter>
        </field>
    </record>

    <record id="action_supplier_management_suppliers" model="ir.actions.act_window">
        <field name="name">Proveedores</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">['|', ('is_company', '=', True), ('parent_id', '=', False)]</field>
        <field name="search_view_id" ref="res_partner_view_search_supplier_management"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('res_partner_view_list_supplier_management')}),
            (0, 0, {'view_mode': 'kanban'}),
            (0, 0, {'view_mode': 'form'})]"/>
        <field name="context">{
            'search_default_suppliers': 1,
            'res_partner_search_mode': 'supplier',
            'default_is_company': True,
            'default_supplier_rank': 1,
            'partner_vat_check_scope': 'supplier',
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay proveedores para estos filtros</p>
        </field>
    </record>

    <!-- Botón "Cuenta proveedor" de la ficha: también para Compras. -->
    <record id="res_partner_view_form_inherit_supplier_management" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.supplier.management</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="customer_account_statement.res_partner_view_form_inherit_account_statement"/>
        <field name="arch" type="xml">
            <button name="action_open_supplier_account_statement" position="attributes">
                <attribute name="groups">account.group_account_invoice,purchase.group_purchase_user</attribute>
            </button>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_supplier_management_invoices" model="ir.actions.act_window">
        <field name="name">Facturas y notas</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('move_type', 'in', ('in_invoice', 'in_refund'))]</field>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('account.view_in_invoice_bill_tree')}),
            (0, 0, {'view_mode': 'kanban'}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('account.view_move_form')})]"/>
        <field name="context">{'default_move_type': 'in_invoice'}</field>
    </record>

    <record id="action_supplier_management_payments" model="ir.actions.act_window">
        <field name="name">Pagos realizados</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('partner_type', '=', 'supplier'), ('payment_type', '=', 'outbound')]</field>
        <field name="context">{
            'default_payment_type': 'outbound',
            'default_partner_type': 'supplier',
            'default_move_journal_types': ('bank', 'cash'),
        }</field>
    </record>

    <record id="action_supplier_management_overdue" model="ir.actions.act_window">
        <field name="name">Comprobantes vencidos</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[
            ('move_type', '=', 'in_invoice'),
            ('state', '=', 'posted'),
            ('payment_state', 'in', ('not_paid', 'partial')),
            ('invoice_date_due', '&lt;', context_today().strftime('%Y-%m-%d')),
        ]</field>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('account.view_in_invoice_bill_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('account.view_move_form')})]"/>
        <field name="context">{'create': False, 'default_move_type': 'in_invoice'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay comprobantes vencidos</p>
        </field>
    </record>
</odoo>

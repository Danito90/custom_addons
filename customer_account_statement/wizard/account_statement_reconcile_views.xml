<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="customer_account_statement_reconcile_view_form" model="ir.ui.view">
        <field name="name">customer.account.statement.reconcile.form</field>
        <field name="model">customer.account.statement.reconcile</field>
        <field name="arch" type="xml">
            <form string="Imputar crédito">
                <group>
                    <group>
                        <field name="credit_line_id" readonly="1"/>
                        <field name="partner_type" invisible="1"/>
                        <label for="partner_id" string="Cliente" invisible="partner_type == 'supplier'"/>
                        <label for="partner_id" string="Proveedor" invisible="partner_type != 'supplier'"/>
                        <field name="partner_id" nolabel="1" readonly="1"/>
                        <field name="statement_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        <field name="company_currency_id" invisible="1"/>
                        <field name="available_amount" readonly="1"/>
                    </group>
                </group>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0" no_open="1">
                        <field name="debit_line_id" column_invisible="True"/>
                        <field name="currency_id" column_invisible="True"/>
                        <field name="allow_partial" column_invisible="True"/>
                        <field name="selected" widget="boolean_toggle"/>
                        <field name="move_id" readonly="1"/>
                        <field name="date" readonly="1"/>
                        <field name="date_maturity" readonly="1"/>
                        <field name="original_currency_id" readonly="1" optional="show"/>
                        <field name="amount_residual" readonly="1" force_save="1"/>
                        <field name="amount_to_apply" sum="Total a imputar"
                               readonly="not selected or not allow_partial" force_save="1"/>
                    </list>
                </field>
                <div class="text-muted">
                    El importe es editable solo si el crédito (recibo, pago o nota de crédito) y la factura
                    están en la moneda de la empresa.
                    En otra moneda se imputa por el total posible.
                </div>
                <footer>
                    <button name="action_reconcile" string="Imputar" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

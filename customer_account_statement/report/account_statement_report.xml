<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_customer_account_statement" model="ir.actions.report">
        <field name="name">Resumen de cuenta</field>
        <field name="model">customer.account.statement</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">customer_account_statement.report_customer_account_statement</field>
        <field name="print_report_name">'%s - %s - %s' % ('Resumen de cuenta de proveedor' if object.partner_type == 'supplier' else 'Resumen de cuenta', object.partner_id.commercial_partner_id.name, object.date_to)</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_view_form_inherit_account_statement" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.account.statement</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button" type="object" name="action_open_account_statement"
                        icon="fa-book" string="Estado de cuenta"
                        groups="account.group_account_invoice,sales_team.group_sale_salesman"/>
                <button class="oe_stat_button" type="object" name="action_open_supplier_account_statement"
                        icon="fa-truck" string="Cuenta proveedor"
                        invisible="supplier_rank == 0"
                        groups="account.group_account_invoice"/>
            </div>
            <group name="misc" position="inside">
                <field name="company_ids" widget="many2many_checkboxes"
                       invisible="parent_id and not is_company"
                       groups="account.group_account_invoice"/>
            </group>
        </field>
    </record>
</odoo>

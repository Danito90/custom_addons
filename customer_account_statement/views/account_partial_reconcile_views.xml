<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_partial_reconcile_view_list_statement" model="ir.ui.view">
        <field name="name">account.partial.reconcile.list.statement</field>
        <field name="model">account.partial.reconcile</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Imputaciones" create="0" edit="0" delete="0">
                <field name="company_currency_id" column_invisible="True"/>
                <field name="max_date" string="Fecha"/>
                <field name="statement_counterpart_move_id" string="Comprobante contraparte"/>
                <field name="statement_counterpart_line_id" string="Apunte" optional="hide"/>
                <field name="amount" string="Importe imputado" sum="Total imputado"/>
                <button name="action_statement_unreconcile" type="object" string="Desimputar"
                        icon="fa-chain-broken" groups="account.group_account_invoice"
                        confirm="¿Deshacer esta imputación? El comprobante volverá a tener saldo pendiente."/>
            </list>
        </field>
    </record>
</odoo>

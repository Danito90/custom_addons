<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="customer_visit_view_list" model="ir.ui.view">
        <field name="name">customer.visit.list</field>
        <field name="model">customer.visit</field>
        <field name="arch" type="xml">
            <list string="Visitas" sample="1"
                  decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'done'">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="visit_type"/>
                <field name="next_visit_date" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'planned'"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="customer_visit_view_form" model="ir.ui.view">
        <field name="name">customer.visit.form</field>
        <field name="model">customer.visit</field>
        <field name="arch" type="xml">
            <form string="Visita">
                <header>
                    <button name="action_done" string="Marcar como realizada" type="object"
                            class="btn-primary" invisible="state != 'planned'"/>
                    <button name="action_cancel" string="Cancelar" type="object"
                            invisible="state != 'planned'"/>
                    <button name="action_reset_to_planned" string="Volver a planificada" type="object"
                            invisible="state == 'planned'"/>
                    <field name="state" widget="statusbar" statusbar_visible="planned,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="visit_type"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="next_visit_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Minuta" name="notes">
                            <field name="notes" placeholder="Temas tratados, acuerdos, pendientes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="customer_visit_view_kanban" model="ir.ui.view">
        <field name="name">customer.visit.kanban</field>
        <field name="model">customer.visit</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1" quick_create="false">
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="partner_id" class="fw-bold fs-5"/>
                            <field name="visit_type" widget="badge"/>
                        </div>
                        <field name="name" class="text-muted small"/>
                        <field name="date" widget="datetime"/>
                        <div t-if="record.next_visit_date.raw_value" class="small">
                            Próxima: <field name="next_visit_date"/>
                        </div>
                        <footer>
                            <field name="activity_ids" widget="kanban_activity"/>
                            <field name="user_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="customer_visit_view_calendar" model="ir.ui.view">
        <field name="name">customer.visit.calendar</field>
        <field name="model">customer.visit</field>
        <field name="arch" type="xml">
            <calendar string="Visitas" date_start="date" color="user_id" mode="month" event_limit="5">
                <field name="partner_id"/>
                <field name="user_id" filters="1"/>
                <field name="visit_type"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="customer_visit_view_search" model="ir.ui.view">
        <field name="name">customer.visit.search</field>
        <field name="model">customer.visit</field>
        <field name="arch" type="xml">
            <search string="Buscar visitas">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <filter string="Mis visitas" name="my_visits" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter string="Planificadas" name="planned" domain="[('state', '=', 'planned')]"/>
                <filter string="Realizadas" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Canceladas" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Fecha" name="filter_date" date="date"/>
                <group>
                    <filter string="Cliente" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Responsable" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Tipo" name="group_type" context="{'group_by': 'visit_type'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Fecha" name="group_date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="customer_visit_action" model="ir.actions.act_window">
        <field name="name">Visitas</field>
        <field name="res_model">customer.visit</field>
        <field name="view_mode">list,kanban,form,calendar</field>
        <field name="search_view_id" ref="customer_visit_view_search"/>
        <field name="context">{'search_default_my_visits': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Registrá tu primera visita a un cliente
            </p>
            <p>
                Planificá visitas, anotá la minuta y programá la próxima.
            </p>
        </field>
    </record>
</odoo>

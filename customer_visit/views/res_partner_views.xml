<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_view_form_inherit_customer_visit" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.customer.visit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_visits"
                        icon="handshake" groups="base.group_user">
                    <field string="Visitas" name="visit_count" widget="statinfo"/>
                </button>
            </div>
        </field>
    </record>
</odoo>

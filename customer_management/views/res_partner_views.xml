<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_view_list_customer_management" model="ir.ui.view">
        <field name="name">res.partner.list.customer.management</field>
        <field name="model">res.partner</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Clientes" editable="bottom" open_form_view="1" create="0" multi_edit="1">
                <!-- create="0": el "Nuevo" estándar agregaría una fila vacía en esta lista editable.
                     El alta abre la ficha completa con este botón. -->
                <header>
                    <button name="action_customer_management_new_customer" type="object"
                            string="Nuevo cliente" class="btn-primary" display="always"
                            groups="base.group_partner_manager,sales_team.group_sale_manager"/>
                </header>
                <field name="can_assign_salesman" column_invisible="True"/>
                <field name="complete_name" string="Nombre" readonly="1"/>
                <field name="vat" string="CUIT" readonly="1"/>
                <field name="user_id" string="Vendedor" widget="many2one_avatar_user"
                       domain="[('share', '=', False)]" options="{'no_create': True}"
                       readonly="not can_assign_salesman"/>
                <field name="company_ids" widget="many2many_tags" readonly="1" optional="show"/>
                <field name="city" readonly="1" optional="show"/>
                <field name="state_id" string="Provincia" readonly="1" optional="show"/>
                <field name="phone" readonly="1" optional="show"/>
                <field name="email" readonly="1" optional="show"/>
            </list>
        </field>
    </record>

    <record id="res_partner_view_search_customer_management" model="ir.ui.view">
        <field name="name">res.partner.search.customer.management</field>
        <field name="model">res.partner</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="company_ids" string="Empresas en las que participa"/>
                <field name="city" string="Ciudad"/>
                <field name="state_id" string="Provincia"/>
            </field>
            <filter name="filter_vat_set" position="before">
                <filter name="my_customers" string="Mis clientes" domain="[('user_id', '=', uid)]"/>
                <filter name="no_salesman" string="Sin vendedor" domain="[('user_id', '=', False)]"/>
                <separator/>
                <filter name="has_receivable_debt" string="Con deuda" domain="[('has_receivable_debt', '=', True)]"/>
                <filter name="has_overdue_debt" string="Con vencidos" domain="[('has_overdue_debt', '=', True)]"/>
                <separator/>
            </filter>
            <filter name="salesperson" position="after">
                <filter name="group_statement_company" string="Empresas en las que participa"
                        context="{'group_by': 'company_ids'}"/>
                <filter name="group_city" string="Ciudad" context="{'group_by': 'city'}"/>
                <filter name="group_state" string="Provincia" context="{'group_by': 'state_id'}"/>
            </filter>
        </field>
    </record>

    <record id="action_customer_management_customers_window" model="ir.actions.act_window">
        <field name="name">Clientes</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="res_partner_view_search_customer_management"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('res_partner_view_list_customer_management')}),
            (0, 0, {'view_mode': 'kanban'}),
            (0, 0, {'view_mode': 'form'})]"/>
        <field name="context">{
            'search_default_customer': 1,
            'search_default_my_customers': 1,
            'res_partner_search_mode': 'customer',
            'default_is_company': True,
            'default_customer_rank': 1,
            'partner_vat_check_scope': 'customer',
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay clientes para estos filtros</p>
            <p>Quitá el filtro "Mis clientes" para ver todos los clientes.</p>
        </field>
    </record>

    <record id="action_customer_management_customers" model="ir.actions.server">
        <field name="name">Clientes</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">action = model.action_customer_management_open('customers')</field>
    </record>
</odoo>

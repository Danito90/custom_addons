<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acciones de ventana: el dominio lo pone action_customer_management_open al abrir el menú. -->
    <record id="action_customer_management_invoices_window" model="ir.actions.act_window">
        <field name="name">Facturas y notas</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('account.view_out_invoice_tree')}),
            (0, 0, {'view_mode': 'kanban'}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('account.view_move_form')})]"/>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
    </record>

    <record id="action_customer_management_payments_window" model="ir.actions.act_window">
        <field name="name">Pagos recibidos</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{
            'default_payment_type': 'inbound',
            'default_partner_type': 'customer',
            'default_move_journal_types': ('bank', 'cash'),
        }</field>
    </record>

    <record id="action_customer_management_overdue_window" model="ir.actions.act_window">
        <field name="name">Comprobantes vencidos</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('account.view_out_invoice_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('account.view_move_form')})]"/>
        <field name="context">{'create': False, 'default_move_type': 'out_invoice'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay comprobantes vencidos</p>
        </field>
    </record>

    <!-- Acciones de servidor de los menús: aplican el ajuste "Vendedores ven solo sus clientes". -->
    <record id="action_customer_management_invoices" model="ir.actions.server">
        <field name="name">Facturas y notas</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">action = model.action_customer_management_open('invoices')</field>
    </record>

    <record id="action_customer_management_payments" model="ir.actions.server">
        <field name="name">Pagos recibidos</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">action = model.action_customer_management_open('payments')</field>
    </record>

    <record id="action_customer_management_overdue" model="ir.actions.server">
        <field name="name">Comprobantes vencidos</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">action = model.action_customer_management_open('overdue')</field>
    </record>

    <record id="action_customer_management_visits" model="ir.actions.server">
        <field name="name">Visitas</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">action = model.action_customer_management_open('visits')</field>
    </record>
</odoo>
